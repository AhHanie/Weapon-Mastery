<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Biotech</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<!-- CE removes this from -->
				<li Class="PatchOperationConditional" MayRequire="ludeon.rimworld.biotech">
					<xpath>Defs/ThingDef[defName="Gun_ToxbombLauncher"]</xpath>
					<match Class="PatchOperationAddModExtension">
						<xpath>Defs/ThingDef[defName="Gun_ToxbombLauncher"]</xpath>
						<value>
							<li Class="SK_WeaponMastery.DefModExtension_Mastery">
								<gmclass>Launcher</gmclass>
							</li>
						</value>
					</match>
				</li>
				<li Class="PatchOperationConditional" MayRequire="ludeon.rimworld.biotech">
					<xpath>Defs/ThingDef[defName="Flamebow"]</xpath>
					<match Class="PatchOperationAddModExtension">
						<xpath>Defs/ThingDef[defName="Flamebow"]</xpath>
						<value>
							<li Class="SK_WeaponMastery.DefModExtension_Mastery">
								<gmclass>Launcher</gmclass>
							</li>
						</value>
					</match>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>